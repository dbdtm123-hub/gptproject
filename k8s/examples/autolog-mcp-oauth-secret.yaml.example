# Template only. Populate outside Git from the configured IdP resource-server client.
# Keep existing lifelog-api/API_TOKEN unchanged; no Garage or DB secret is needed here.
apiVersion: v1
kind: Secret
metadata:
  name: autolog-mcp-oauth
  namespace: lifelog
type: Opaque
stringData:
  INTROSPECTION_CLIENT_SECRET: REPLACE_OUTSIDE_GIT
