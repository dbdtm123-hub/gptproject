# Documentation only: do not apply placeholders. Use protected files/secret manager.
# Garage key must have READ only on autolog-public, with WRITE/OWNER disabled.
# Never copy autolog-backend credentials here.
apiVersion: v1
kind: Secret
metadata:
  name: lifelog-garage-reader
  namespace: lifelog
type: Opaque
stringData:
  S3_ACCESS_KEY: REPLACE_WITH_READER_ACCESS_KEY
  S3_SECRET_KEY: REPLACE_WITH_READER_SECRET_KEY
