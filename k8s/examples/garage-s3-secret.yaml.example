# Documentation only. Supply actual values from protected files; do not apply placeholders.
# Use S3 key credentials generated by Garage, not an RPC secret or administration token.
apiVersion: v1
kind: Secret
metadata:
  name: lifelog-garage-s3
  namespace: lifelog
type: Opaque
stringData:
  S3_ACCESS_KEY: REPLACE_SECURELY
  S3_SECRET_KEY: REPLACE_SECURELY
