# DOCUMENTATION ONLY. Not referenced by any Kustomization.
# Supply values through a secret manager or protected local files; never commit real values.
apiVersion: v1
kind: Secret
metadata:
  name: lifelog-db
  namespace: lifelog
type: Opaque
stringData:
  POSTGRES_PASSWORD: REPLACE_WITH_STRONG_PASSWORD
  DATABASE_URL: postgresql+psycopg://lifelog:URL_ENCODED_PASSWORD@lifelog-postgres:5432/lifelog
---
# Optional for manual recording; required for real AI parsing. Backend only.
apiVersion: v1
kind: Secret
metadata:
  name: lifelog-openai
  namespace: lifelog
type: Opaque
stringData:
  OPENAI_API_KEY: REPLACE_SECURELY
---
apiVersion: v1
kind: Secret
metadata:
  name: lifelog-app
  namespace: lifelog
type: Opaque
stringData:
  APP_USERNAME: REPLACE_SECURELY
  APP_PASSWORD: REPLACE_SECURELY
