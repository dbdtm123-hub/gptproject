# Local development only; replace database credentials before deployment.
POSTGRES_USER=lifelog
POSTGRES_PASSWORD=
POSTGRES_DB=lifelog
POSTGRES_PORT=5432
BACKEND_PORT=8000
# For running the backend outside Docker. Compose supplies the container DB URL.
DATABASE_URL=postgresql+psycopg://lifelog:URL_ENCODED_PASSWORD@localhost:5432/lifelog
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Backend only. Optional for manual-only testing; required for AI parsing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Frontend server only, never NEXT_PUBLIC_*.
APP_USERNAME=autolog
APP_PASSWORD=
BACKEND_URL=http://localhost:8000
FRONTEND_PORT=3000
