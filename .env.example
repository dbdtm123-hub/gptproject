# Local development only; replace database credentials before deployment.
POSTGRES_USER=lifelog
POSTGRES_PASSWORD=
POSTGRES_DB=lifelog
POSTGRES_PORT=5432
BACKEND_PORT=8000
# For running the backend outside Docker. Compose supplies the container DB URL.
DATABASE_URL=postgresql+psycopg://lifelog:URL_ENCODED_PASSWORD@localhost:5432/lifelog
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Backend write-only client token (32+ random characters). Never NEXT_PUBLIC_*.
API_TOKEN=
ACTION_SERVER_URL=https://autolog.example.com
# Optional backend classification. External ingest and web entry need neither.
ENABLE_OPENAI_CLASSIFICATION=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Backend admin login credentials; never NEXT_PUBLIC_*.
APP_USERNAME=autolog
APP_PASSWORD=
BACKEND_URL=http://localhost:8000
FRONTEND_PORT=3000

# Optional backend image uploads. Missing values disable uploads, not article CRUD.
S3_ENDPOINT=http://garage.lifelog.svc.cluster.local:3900
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=autolog-public
S3_REGION=garage
S3_PUBLIC_BASE_URL=https://img.myhomlab.win

# Optional explicit grant: token-protected integration reads of drafts/private fields.
# Public /api/articles reads retain the original cookie-only draft policy.
MCP_PRIVATE_READS_ENABLED=false
