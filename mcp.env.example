# MCP runs as a separate process using the same backend image/dependency lock.
# Load this file explicitly with uvicorn --env-file; MCP does not auto-read .env.
# Copy to an ignored protected .env.mcp and populate outside Git.
AUTOLOG_MCP_RESOURCE=https://mcp.example.com/mcp
AUTOLOG_MCP_ISSUER=https://identity.example.com
AUTOLOG_MCP_INTROSPECTION_URL=https://identity.example.com/introspect
AUTOLOG_MCP_INTROSPECTION_CLIENT_ID=autolog-resource-server
AUTOLOG_MCP_INTROSPECTION_CLIENT_SECRET=
AUTOLOG_MCP_ALLOWED_SUBJECTS=[]
AUTOLOG_MCP_ALLOWED_ORIGINS=["https://chatgpt.com"]
AUTOLOG_MCP_BACKEND_URL=http://127.0.0.1:8000
# Reuse existing AutoLog API_TOKEN from a secure server setting; never an OAuth access token.
AUTOLOG_MCP_BACKEND_TOKEN=
AUTOLOG_MCP_IMAGE_PUBLIC_BASE=https://img.example.com
AUTOLOG_MCP_BLOG_PUBLIC_BASE=https://autolog.example.com
# Populate exact real platform host/path prefixes only after observing a real FileRef.
AUTOLOG_MCP_FILE_SOURCES={}
AUTOLOG_MCP_PRIVATE_READS=false

# Optional per-subject ceiling, in addition to token scopes and allowed subjects.
AUTOLOG_MCP_SUBJECT_SCOPES={}
